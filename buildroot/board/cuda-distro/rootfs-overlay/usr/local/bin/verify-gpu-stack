#!/bin/sh
# Run on the booted distribution; packaging evidence is separate from execution.
set -eu
release=$(uname -r)
for module in nvidia nvidia-uvm nvidia-modeset nvidia-drm; do
    test "$(modinfo -F version "$module")" = 550.127.05
    case "$(modinfo -F vermagic "$module")" in
        "$release "*) ;;
        *) echo "FAIL: $module kernel version mismatch" >&2; exit 1 ;;
    esac
done
test -s "/lib/modules/$release/modules.dep"
grep -q 'nvidia-uvm.ko' "/lib/modules/$release/modules.dep"
for library in /usr/lib/libcuda.so.550.127.05 /usr/lib/libnvidia-ml.so.550.127.05 /usr/lib/libcudart.so.12 /usr/lib/libcudnn.so.9 /usr/lib/libcublas.so.12 /usr/lib/libnvrtc.so.12; do
    test -s "$library" || { echo "FAIL: $library" >&2; exit 1; }
done
modprobe nvidia
modprobe nvidia-uvm
nvidia-modprobe -c 0
nvidia-modprobe -u -c 0
nvidia-smi
cuda-benchmark --all --output-json /var/log/cuda-benchmark/stack-check.json
