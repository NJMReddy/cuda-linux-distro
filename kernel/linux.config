CONFIG_RD_LZMA=y
CONFIG_RD_XZ=y
CONFIG_RD_LZO=y
CONFIG_RD_LZ4=y
CONFIG_RD_ZSTD=y

#
# End of configuration
#

# Boot without initramfs: partition parser and root storage must be built in.
CONFIG_EFI_PARTITION=y
CONFIG_BLK_DEV=y
CONFIG_BLOCK=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_UNIX=y
CONFIG_TTY=y
CONFIG_MULTIUSER=y
CONFIG_FHANDLE=y
CONFIG_POSIX_MQUEUE=y
CONFIG_SECURITY_YAMA=y
CONFIG_RELOCATABLE=y
CONFIG_CGROUP_DEVICE=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_NETFILTER=y
